{
  "builds": [
    {
      "src": "api/*.php",
      "use": "vercel-php@0.9.0"
    },
    {
      "src": "*.php",
      "use": "vercel-php@0.9.0"
    }
  ],
  "routes": [
    { "src": "/login", "dest": "/api/login.php" },
    { "src": "/register", "dest": "/api/register.php" },
    { "src": "/logout", "dest": "/api/logout.php" },
    { "src": "/dashboard", "dest": "/dashboard.php" },
    { "src": "/admin_dashboard", "dest": "/admin_dashboard.php" }
  ]
}